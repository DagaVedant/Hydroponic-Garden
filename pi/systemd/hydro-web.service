# installed by systemd/install.sh, which fills in the two @ fields
[Unit]
Description=hydro dashboard on port 8080
After=network-online.target mosquitto.service
Wants=mosquitto.service

[Service]
User=@USER@
WorkingDirectory=@PI_DIR@
ExecStart=@PI_DIR@/.venv/bin/python -m web.app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
